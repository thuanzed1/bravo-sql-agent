# CẤU HÌNH API AI CHO BRAVO SQL AGENT
# Đổi tên file này thành .env (hoặc dán key trực tiếp trong giao diện Cài đặt)

# 1. Groq API (Miễn phí, phản hồi rất nhanh - khuyến nghị cho demo)
# Hỗ trợ nhiều key cách nhau bằng dấu phẩy: gsk_key1,gsk_key2
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini API (hỗ trợ xoay vòng nhiều key cách nhau bằng dấu phẩy)
# Ví dụ: VITE_GEMINI_API_KEY=AIzaKey1,AIzaKey2,AIzaKey3
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-2.5-flash

# Hoặc nếu dùng Model đã train (Tuned Model) trên Google AI Studio:
# VITE_GEMINI_MODEL=tunedModels/bravo-sql-flash-xxxx

# 3. OpenAI API (hoặc endpoint tương thích OpenAI)
# VITE_OPENAI_API_KEY=sk-...
